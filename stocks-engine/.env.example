NQ_ENV=production
NQ_HOST=0.0.0.0
PORT=4173
NQ_DATA_DIR=/data
NQ_DEMO_MODE=false
NQ_PAPER_ONLY=true
NQ_YAHOO_ENABLED=true
NQ_YAHOO_DELAY_MINUTES=10
NQ_ALLOW_DELAYED_PAPER=true
NQ_MIN_UNIVERSE_SIZE=700
NQ_INTRADAY_UNIVERSE_LIMIT=50
NQ_ACCESS_USER=paperfund
NQ_ACCESS_PASSWORD=CHANGE_WITH_A_LONG_RANDOM_PASSWORD
NQ_DATA_LICENSE_ACKNOWLEDGED=false
NQ_STALE_AFTER_HOURS=30
ARJUM_DAILY_LIMIT=1000
NQ_ARJUM_ENABLED=true
# 20 actionable tickers x 5 Arjum resources = at most 100 calls/day.
NQ_ARJUM_CANDIDATE_LIMIT=20
NQ_ARJUM_CACHE_HOURS=24
# IDX paper-trading liquidity gates (Rupiah average daily traded value).
NQ_LIQUIDITY_MIN_ADV=250000000
NQ_LIQUID_UNIVERSE_LIMIT=100
NQ_TECHNICAL_CANDIDATE_LIMIT=50
# ARJUM_API_KEY=do-not-commit-this
# Set only after verifying the path in your Arjum dashboard.
# ARJUM_FINANCIAL_ENDPOINT=/api/.../{symbol}
